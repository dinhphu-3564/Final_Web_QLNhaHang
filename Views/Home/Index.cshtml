                <div class="category-card-overlay">
                    <h3>Các món Lẩu</h3>
                    <span>10+ món</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="1" class="category-card-link"></a>
            </div>
            
            <div class="category-card">
                <img src="/images/dishes/banh-trang-cuon.png" alt="Cuốn">
                <div class="category-card-overlay">
                    <h3>Bánh tráng cuốn</h3>
                    <span>8+ món</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="2" class="category-card-link"></a>
            </div>
            
            <div class="category-card">
                <img src="/images/dishes/vit-nuong-chao.png" alt="Nướng">
                <div class="category-card-overlay">
                    <h3>Món nướng</h3>
                    <span>12+ món</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="3" class="category-card-link"></a>
            </div>
            
            <div class="category-card">
                <img src="/images/dishes/banh-xeo.png" alt="Đặc sản">
                <div class="category-card-overlay">
                    <h3>Món đặc sản</h3>
                    <span>15+ món</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="4" class="category-card-link"></a>
            </div>
            
            <div class="category-card">
                <img src="/images/dishes/ca-keo-muoi-ot.png" alt="Món nhẹ">
                <div class="category-card-overlay">
                    <h3>Món ăn nhẹ</h3>
                    <span>8+ món</span>
                </div>
                <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="5" class="category-card-link"></a>
            </div>
            
            <div class="category-card">
                <img src="/images/dishes/lau-ga-la-giang.png" alt="Gà">
                <div class="category-card-overlay">
                    <h3>Món gà</h3>
                    <span>6+ món</span>
