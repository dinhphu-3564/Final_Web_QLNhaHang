@model dynamic
@{
    ViewData["Title"] = "Trang chủ - Nhà hàng Việt";
}

<!-- Hero Slider -->
<section class="hero-slider" id="heroSlider">
    <div class="slider-container">
        <div class="slider-track" id="sliderTrack">
            <!-- Slide 1 -->
            <div class="slide active">
                <img src="/images/banners/hero-banner.png" alt="Ẩm thực Việt Nam">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h2 class="slide-title">
                        Hương vị <span>Việt Nam</span><br>chính gốc
                    </h2>
                    <p class="slide-desc">
                        Trải nghiệm ẩm thực đậm đà bản sắc miền Nam Bộ với gần 100 món ăn đặc sắc
                    </p>
                    <a asp-controller="Menu" asp-action="Index" class="slide-btn">
                        <i class="fas fa-utensils"></i> Xem thực đơn
                    </a>
                </div>
            </div>
            
            <!-- Slide 2 -->
            <div class="slide">
                <img src="/images/dishes/lau-ca-keo.png" alt="Lẩu cá kèo">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h2 class="slide-title">
                        <span>Lẩu mắm</span> cá kèo<br>đặc sản miền Tây
                    </h2>
                    <p class="slide-desc">
                        Món ăn đậm chất vùng sông nước, ngon ngọt tự nhiên, cuốn hút mọi thực khách
                    </p>
                    <a asp-controller="Menu" asp-action="Index" class="slide-btn">
                        <i class="fas fa-fire"></i> Đặt món ngay
                    </a>
                </div>
            </div>
            
            <!-- Slide 3 -->
            <div class="slide">
                <img src="/images/dishes/banh-xeo.png" alt="Bánh xèo">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h2 class="slide-title">
                        <span>Đặt bàn</span> tiện lợi<br>ưu đãi hấp dẫn
                    </h2>
                    <p class="slide-desc">
                        Không gian ấm cúng, phục vụ tận tâm. Gọi ngay 1800 2028 để đặt bàn
                    </p>
                    <a asp-controller="Booking" asp-action="Index" class="slide-btn">
                        <i class="fas fa-calendar-check"></i> Đặt bàn ngay
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Navigation Arrows -->
        <button class="slider-nav prev" onclick="changeSlide(-1)">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="slider-nav next" onclick="changeSlide(1)">
            <i class="fas fa-chevron-right"></i>
        </button>
        
        <!-- Dots -->
        <div class="slider-dots">
            <span class="slider-dot active" onclick="goToSlide(0)"></span>
            <span class="slider-dot" onclick="goToSlide(1)"></span>
            <span class="slider-dot" onclick="goToSlide(2)"></span>
        </div>
    </div>
</section>

<!-- Quick Features -->
<section class="quick-features">
    <div class="container">
        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-shipping-fast"></i>
                </div>
                <div class="feature-text">
                    <strong>Giao hàng nhanh 30 phút</strong>
                    <span>Miễn phí ship từ 150.000đ</span>
                </div>
            </div>
            
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <div class="feature-text">
                    <strong>Nguyên liệu tươi sạch</strong>
                    <span>Chọn lọc kỹ càng mỗi ngày</span>
                </div>
            </div>
            
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-award"></i>
                </div>
                <div class="feature-text">
                    <strong>Đầu bếp chuyên nghiệp</strong>
                    <span>Hơn 20 năm kinh nghiệm</span>
                </div>
            </div>
            
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="feature-text">
                    <strong>An toàn thực phẩm</strong>
                    <span>Đạt chuẩn vệ sinh ATTP</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Menu Categories Section -->
