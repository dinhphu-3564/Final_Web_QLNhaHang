            {
                @foreach (var dish in ((List<Web_QLNhaHang.Models.Dish>)ViewBag.FeaturedDishes).Take(8))
                {
                    <div class="dish-card-modern">
                        <div class="dish-card-image">
                            @if (!string.IsNullOrEmpty(dish.ImageUrl))
                            {
                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@dish.DishId">
                                    <img src="@dish.ImageUrl" alt="@dish.DishName">
                                </a>
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; background: var(--bg-light); display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-utensils" style="font-size: 48px; color: var(--text-light);"></i>
                                </div>
                            }
                            
                            @if (dish.IsFeatured)
                            {
                                <span class="dish-card-badge">
                                    <i class="fas fa-fire"></i> Hot
                                </span>
                            }
                            
                            <div class="dish-card-wishlist">
                                <i class="far fa-heart"></i>
                            </div>
                        </div>
                        
                        <div class="dish-card-body">
                            <span class="dish-card-category">@(dish.Category?.CategoryName ?? "Món đặc trưng")</span>
                            <h3 class="dish-card-title">
                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@dish.DishId">@dish.DishName</a>
                            </h3>
                            <p class="dish-card-desc">@dish.Description</p>
                            
                            <div class="dish-card-footer">
                                <span class="dish-card-price">@dish.Price.ToString("N0")₫</span>
                                <button class="dish-card-add" onclick="addToCart(@dish.DishId)" title="Thêm vào giỏ">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback dishes -->
                <div class="dish-card-modern">
                    <div class="dish-card-image">
                        <img src="/images/dishes/ca-keo-muoi-ot.png" alt="Cá kèo muối ớt">
                        <span class="dish-card-badge"><i class="fas fa-fire"></i> Hot</span>
                        <div class="dish-card-wishlist"><i class="far fa-heart"></i></div>
                    </div>
                    <div class="dish-card-body">
                        <span class="dish-card-category">Món chiên</span>
                        <h3 class="dish-card-title"><a href="#">Cá kèo muối ớt</a></h3>
                        <p class="dish-card-desc">Cá kèo tươi chiên giòn, thấm vị muối ớt cay nồng đặc trưng miền Tây</p>
                        <div class="dish-card-footer">
                            <span class="dish-card-price">189,000₫</span>
                            <button class="dish-card-add"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="dish-card-modern">
                    <div class="dish-card-image">
                        <img src="/images/dishes/banh-trang-cuon.png" alt="Bánh tráng cuốn">
                        <span class="dish-card-badge"><i class="fas fa-star"></i> Bán chạy</span>
                        <div class="dish-card-wishlist"><i class="far fa-heart"></i></div>
                    </div>
                    <div class="dish-card-body">
                        <span class="dish-card-category">Món cuốn</span>
                        <h3 class="dish-card-title"><a href="#">Bánh tráng cuốn thịt heo</a></h3>
                        <p class="dish-card-desc">Bánh tráng cuốn ba chỉ quay giòn cùng rau sống tươi ngon</p>
                        <div class="dish-card-footer">
                            <span class="dish-card-price">159,000₫</span>
                            <button class="dish-card-add"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="dish-card-modern">
                    <div class="dish-card-image">
                        <img src="/images/dishes/lau-ga-la-giang.png" alt="Lẩu gà lá giang">
                        <div class="dish-card-wishlist"><i class="far fa-heart"></i></div>
                    </div>
                    <div class="dish-card-body">
                        <span class="dish-card-category">Lẩu</span>
                        <h3 class="dish-card-title"><a href="#">Lẩu gà lá giang</a></h3>
                        <p class="dish-card-desc">Gà ta thả vườn nấu với lá giang chua thanh mát lành</p>
                        <div class="dish-card-footer">
                            <span class="dish-card-price">269,000₫</span>
                            <button class="dish-card-add"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="dish-card-modern">
                    <div class="dish-card-image">
                        <img src="/images/dishes/banh-xeo.png" alt="Bánh xèo">
                        <div class="dish-card-wishlist"><i class="far fa-heart"></i></div>
                    </div>
                    <div class="dish-card-body">
                        <span class="dish-card-category">Bánh</span>
                        <h3 class="dish-card-title"><a href="#">Bánh xèo miền Tây</a></h3>
                        <p class="dish-card-desc">Bánh xèo vỏ giòn rụm, nhân tôm thịt thơm ngon béo ngậy</p>
                        <div class="dish-card-footer">
                            <span class="dish-card-price">129,000₫</span>
                            <button class="dish-card-add"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
        
