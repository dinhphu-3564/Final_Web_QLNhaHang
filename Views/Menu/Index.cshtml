@model List<Web_QLNhaHang.Models.Dish>
@{
    ViewData["Title"] = "Thực đơn";
}

<!-- Page Banner -->
<div class="page-banner">
    <div class="container">
        <h1><i class="fas fa-utensils me-3"></i>Thực đơn</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thực đơn</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Quick Actions -->
<section class="menu-actions">
    <div class="container">
        <div class="actions-grid">
            <a href="/Booking" class="action-card">
                <div class="action-icon" style="background: var(--gradient-primary);">
                    <i class="fas fa-utensils"></i>
                </div>
                <div class="action-text">
                    <strong>Đặt bàn</strong>
                    <span>Tại nhà hàng</span>
                </div>
            </a>
            
            <a asp-controller="Cart" asp-action="Index" class="action-card">
                <div class="action-icon" style="background: var(--gradient-success);">
                    <i class="fas fa-motorcycle"></i>
                </div>
                <div class="action-text">
                    <strong>Đặt ship</strong>
                    <span>Giao tận nơi</span>
                </div>
            </a>
            
            <a href="/Booking" class="action-card">
                <div class="action-icon" style="background: var(--gradient-accent);">
                    <i class="fas fa-glass-cheers"></i>
                </div>
                <div class="action-text">
                    <strong>Đặt tiệc</strong>
                    <span>Tại gia</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Filter Section -->
<section class="filter-section">
    <div class="container">
        <!-- Category Pills -->
        <div class="category-pills-wrapper">
            <a asp-action="Index" class="category-pill @(ViewBag.SelectedCategoryId == null ? "active" : "")">
                <i class="fas fa-th-large me-2"></i>Tất cả món
            </a>
            @if (ViewBag.Categories != null)
            {
                @foreach (var category in (List<Web_QLNhaHang.Models.Category>)ViewBag.Categories)
                {
                    <a asp-action="Index" 
                       asp-route-categoryId="@category.CategoryId"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-sort="@ViewBag.CurrentSort"
                       class="category-pill @(ViewBag.SelectedCategoryId == category.CategoryId ? "active" : "")">
                        @category.CategoryName
                    </a>
                }
            }
        </div>
        
        <!-- Search & Sort -->
        <div class="filter-controls">
            <form asp-action="Index" method="get" class="search-form">
                @if (ViewBag.SelectedCategoryId != null)
                {
                    <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId" />
                }
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSort as string))
                {
                    <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />
                }
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="searchTerm" placeholder="Tìm món ăn..." value="@ViewBag.SearchTerm">
                    <button type="submit">Tìm</button>
                </div>
            </form>
            
            <form asp-action="Index" method="get" id="sortForm" class="sort-form">
                @if (ViewBag.SelectedCategoryId != null)
                {
                    <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId" />
                }
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                {
                    <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />
                }
                <select name="sort" class="sort-select" onchange="document.getElementById('sortForm').submit();">
                    <option value="">Sắp xếp theo</option>
                    <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Giá: Thấp → Cao</option>
                    <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Giá: Cao → Thấp</option>
                </select>
            </form>
        </div>
    </div>
</section>

<!-- Dishes Grid -->
<section class="dishes-section">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="dishes-header">
                <p class="result-count">
                    <i class="fas fa-check-circle me-2" style="color: var(--success);"></i>
                    Tìm thấy <strong>@Model.Count</strong> món ăn
                </p>
            </div>
            
            <div class="dishes-grid">
                @foreach (var dish in Model)
                {
                    <div class="dish-card-v2">
                        <a asp-action="Details" asp-route-id="@dish.DishId" class="dish-image-wrapper">
                            @if (!string.IsNullOrEmpty(dish.ImageUrl))
                            {
                                <img src="@dish.ImageUrl" alt="@dish.DishName">
                            }
                            else
                            {
                                <div class="placeholder-img">
                                    <i class="fas fa-utensils"></i>
                                </div>
                            }
                            
                            @if (dish.IsFeatured)
                            {
                                <span class="dish-badge hot">
                                    <i class="fas fa-fire"></i> Hot
                                </span>
                            }
                            
                            <div class="dish-overlay">
                                <span class="view-detail">
                                    <i class="fas fa-eye me-1"></i> Xem chi tiết
                                </span>
                            </div>
                        </a>
                        
                        <div class="dish-content">
                            <div class="dish-category">
                                <i class="fas fa-tag me-1"></i>
                                @(dish.Category?.CategoryName ?? "Món đặc trưng")
                            </div>
                            
                            <h3 class="dish-title">
                                <a asp-action="Details" asp-route-id="@dish.DishId">@dish.DishName</a>
                            </h3>
                            
                            <p class="dish-desc">@(dish.Description?.Length > 60 ? dish.Description.Substring(0, 60) + "..." : dish.Description)</p>
                            
                            <div class="dish-footer">
                                <div class="dish-price">
                                    @dish.Price.ToString("N0")₫
                                </div>
                                <button class="btn-add-cart" type="button" data-dish-id="@dish.DishId" onclick="addToCart(@dish.DishId)">
                                    <i class="fas fa-cart-plus"></i>
                                    <span class="d-none d-md-inline ms-1">Thêm</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3>Không tìm thấy món ăn</h3>
                <p>Không có món ăn nào phù hợp với tiêu chí tìm kiếm của bạn.</p>
                <a asp-action="Index" class="btn-primary-custom">
                    <i class="fas fa-redo me-2"></i>Xem tất cả món
                </a>
            </div>
        }

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="pagination-wrapper" aria-label="Page navigation">
                <ul class="pagination">
                    @{
                        var currentPage = (int)ViewBag.CurrentPage;
                        var totalPages = (int)ViewBag.TotalPages;
                    }
                    
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(currentPage - 1)" 
                           asp-route-categoryId="@ViewBag.SelectedCategoryId"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-sort="@ViewBag.CurrentSort">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-categoryId="@ViewBag.SelectedCategoryId"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-sort="@ViewBag.CurrentSort">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(currentPage + 1)"
                           asp-route-categoryId="@ViewBag.SelectedCategoryId"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-sort="@ViewBag.CurrentSort">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

<style>
    /* Menu Actions */
    .menu-actions {
        padding: var(--space-8) 0;
        background: white;
        margin-bottom: var(--space-4);
    }

    .actions-grid {
        display: flex;
        justify-content: center;
        gap: var(--space-6);
        flex-wrap: wrap;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4) var(--space-6);
        background: var(--bg-light);
        border-radius: var(--radius-xl);
        text-decoration: none;
        transition: all var(--transition-base);
        border: 2px solid transparent;
    }

    .action-card:hover {
        background: white;
        border-color: var(--primary);
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    .action-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }

    .action-text strong {
        display: block;
        color: var(--text-primary);
        font-size: var(--text-base);
        font-weight: var(--font-semibold);
    }

    .action-text span {
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    /* Filter Section */
    .filter-section {
        padding: var(--space-6) 0;
        background: white;
        border-bottom: 1px solid var(--border-light);
        position: sticky;
        top: 70px;
        z-index: 100;
        box-shadow: var(--shadow-sm);
    }

    .category-pills-wrapper {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin-bottom: var(--space-4);
        overflow-x: auto;
        padding-bottom: var(--space-2);
        -webkit-overflow-scrolling: touch;
    }

    .category-pill {
        padding: var(--space-2) var(--space-4);
        background: var(--bg-light);
        border: 2px solid transparent;
        border-radius: var(--radius-full);
        color: var(--text-secondary);
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        text-decoration: none;
        white-space: nowrap;
        transition: all var(--transition-fast);
    }

    .category-pill:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: white;
    }

    .category-pill.active {
        background: var(--gradient-primary);
        color: white;
        border-color: var(--primary);
    }

    .filter-controls {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
        align-items: center;
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        background: var(--bg-light);
        border-radius: var(--radius-full);
        padding: var(--space-2);
        border: 2px solid transparent;
        transition: all var(--transition-fast);
        flex: 1;
        max-width: 400px;
    }

    .search-input-wrapper:focus-within {
        border-color: var(--primary);
        background: white;
    }

    .search-input-wrapper i {
        color: var(--text-muted);
        padding: 0 var(--space-3);
    }

    .search-input-wrapper input {
        flex: 1;
        border: none;
        background: transparent;
        padding: var(--space-2);
        outline: none;
        font-size: var(--text-sm);
    }

    .search-input-wrapper button {
        background: var(--gradient-primary);
        color: white;
        border: none;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-weight: var(--font-semibold);
        font-size: var(--text-sm);
        cursor: pointer;
        transition: all var(--transition-fast);
    }

    .search-input-wrapper button:hover {
        opacity: 0.9;
    }

    .sort-select {
        padding: var(--space-3) var(--space-4);
        border: 2px solid var(--border-light);
        border-radius: var(--radius-lg);
        background: white;
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        color: var(--text-secondary);
        cursor: pointer;
        outline: none;
        min-width: 180px;
    }

    .sort-select:focus {
        border-color: var(--primary);
    }

    /* Dishes Section */
    .dishes-section {
        padding: var(--space-8) 0 var(--space-16);
        background: var(--bg-light);
    }

    .dishes-header {
        margin-bottom: var(--space-6);
    }

    .result-count {
        color: var(--text-secondary);
        font-size: var(--text-sm);
        margin: 0;
    }

    .dishes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--space-6);
    }

    /* Dish Card V2 */
    .dish-card-v2 {
        background: white;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: all var(--transition-base);
        display: flex;
        flex-direction: column;
    }

    .dish-card-v2:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-xl);
    }

    .dish-image-wrapper {
        position: relative;
        height: 200px;
        overflow: hidden;
        display: block;
    }

    .dish-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-slow);
    }

    .dish-card-v2:hover .dish-image-wrapper img {
        transform: scale(1.1);
    }

    .placeholder-img {
        width: 100%;
        height: 100%;
        background: var(--bg-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .placeholder-img i {
        font-size: 48px;
        color: var(--text-light);
    }

    .dish-badge {
        position: absolute;
        top: var(--space-3);
        left: var(--space-3);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        color: white;
    }

    .dish-badge.hot {
        background: var(--gradient-primary);
    }

    .dish-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .dish-card-v2:hover .dish-overlay {
        opacity: 1;
    }

    .view-detail {
        background: white;
        color: var(--text-primary);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
    }

    .dish-content {
        padding: var(--space-5);
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .dish-category {
        font-size: var(--text-xs);
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: var(--space-2);
    }

    .dish-title {
        font-size: var(--text-lg);
        font-weight: var(--font-semibold);
        margin-bottom: var(--space-2);
        line-height: var(--leading-tight);
    }

    .dish-title a {
        color: var(--text-primary);
        text-decoration: none;
        transition: color var(--transition-fast);
    }

    .dish-title a:hover {
        color: var(--primary);
    }

    .dish-desc {
        font-size: var(--text-sm);
        color: var(--text-muted);
        margin-bottom: var(--space-4);
        line-height: var(--leading-relaxed);
        flex: 1;
    }

    .dish-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-light);
    }

    .dish-price {
        font-size: var(--text-xl);
        font-weight: var(--font-bold);
        color: var(--primary);
    }

    .btn-add-cart {
        background: var(--gradient-primary);
        color: white;
        border: none;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-lg);
        font-weight: var(--font-semibold);
        font-size: var(--text-sm);
        cursor: pointer;
        transition: all var(--transition-base);
        display: flex;
        align-items: center;
    }

    .btn-add-cart:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-primary);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: var(--space-16);
        background: white;
        border-radius: var(--radius-xl);
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        background: var(--bg-light);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--space-6);
    }

    .empty-icon i {
        font-size: 48px;
        color: var(--text-light);
    }

    .empty-state h3 {
        color: var(--text-primary);
        margin-bottom: var(--space-3);
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: var(--space-6);
    }

    /* Pagination */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        margin-top: var(--space-10);
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .filter-section {
            top: 60px;
        }

        .filter-controls {
            flex-direction: column;
            align-items: stretch;
        }

        .search-input-wrapper {
            max-width: none;
        }

        .sort-select {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .actions-grid {
            justify-content: flex-start;
            gap: var(--space-3);
        }

        .action-card {
            padding: var(--space-3);
            flex: 1;
            min-width: 120px;
            flex-direction: column;
            text-align: center;
        }

        .action-icon {
            width: 48px;
            height: 48px;
            font-size: 1.25rem;
        }

        .dishes-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-4);
        }

        .dish-image-wrapper {
            height: 160px;
        }

        .dish-content {
            padding: var(--space-3);
        }

        .dish-title {
            font-size: var(--text-base);
        }

        .dish-desc {
            display: none;
        }

        .dish-price {
            font-size: var(--text-lg);
        }
    }

    @@media (max-width: 480px) {
        .dishes-grid {
            grid-template-columns: 1fr;
        }

        .dish-image-wrapper {
            height: 200px;
        }

        .dish-desc {
            display: block;
        }
    }
</style>

@section Scripts {
    <script>
        function addToCart(dishId) {
            var $btn = $('[data-dish-id="' + dishId + '"]');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { dishId: dishId, quantity: 1 },
                success: function(data) {
                    $btn.prop('disabled', false).html(originalHtml);
                    
                    if (data && data.success) {
                        updateCartCount(data.cartCount || 0);
                        showToast('Đã thêm món vào giỏ hàng!', 'success');
                    } else {
                        showToast(data.message || 'Có lỗi xảy ra!', 'error');
                    }
                },
                error: function() {
                    $btn.prop('disabled', false).html(originalHtml);
                    showToast('Có lỗi kết nối. Vui lòng thử lại!', 'error');
                }
            });
        }
    </script>
}
