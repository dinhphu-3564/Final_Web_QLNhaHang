@{
    ViewData["Title"] = "Thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var stats = ViewBag.Stats;
}

<style>
    .chart-container {
        background: white;
        border-radius: 15px;
        padding: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        margin-bottom: 1rem;
    }
    
    .chart-wrapper {
        max-height: 250px;
        position: relative;
    }
    
    .chart-wrapper-small {
        max-height: 200px;
        max-width: 250px;
        margin: 0 auto;
    }
    
    .chart-container h5 {
        color: #2c3e50;
        margin-bottom: 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .chart-container h5 i {
        color: #4a7c59;
    }
    
    .stats-overview {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .overview-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.3s;
    }
    
    .overview-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.12);
    }
    
    .overview-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }
    
    .overview-icon.green { background: linear-gradient(135deg, #4a7c59 0%, #3d6349 100%); }
    .overview-icon.blue { background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); }
    .overview-icon.orange { background: linear-gradient(135deg, #e67e22 0%, #d35400 100%); }
    .overview-icon.purple { background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%); }
    .overview-icon.red { background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); }
    .overview-icon.teal { background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%); }
    
    .overview-info h6 {
        color: #7f8c8d;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
    }
    
    .overview-info h3 {
        color: #2c3e50;
        font-weight: 700;
        margin: 0;
    }
    
    .chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }
    
    .chart-row-equal {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }
    
    .chart-row-three {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    
    @@media (max-width: 992px) {
        .chart-row, .chart-row-equal, .chart-row-three {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <h2><i class="fas fa-chart-line"></i> Thống kê & Báo cáo</h2>
</div>

<!-- Overview Stats -->
<div class="stats-overview">
    <div class="overview-card">
        <div class="overview-icon green">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="overview-info">
            <h6>Tổng đơn hàng</h6>
            <h3>@(stats?.TotalOrders ?? 0)</h3>
        </div>
    </div>
    <div class="overview-card">
        <div class="overview-icon blue">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="overview-info">
            <h6>Tổng doanh thu</h6>
            <h3>@(stats?.TotalRevenue != null ? ((decimal)stats.TotalRevenue).ToString("N0") : "0") ₫</h3>
        </div>
    </div>
    <div class="overview-card">
        <div class="overview-icon orange">
            <i class="fas fa-calendar-alt"></i>
        </div>
        <div class="overview-info">
            <h6>Doanh thu tháng này</h6>
            <h3>@(stats?.MonthlyRevenue != null ? ((decimal)stats.MonthlyRevenue).ToString("N0") : "0") ₫</h3>
        </div>
    </div>
    <div class="overview-card">
        <div class="overview-icon purple">
            <i class="fas fa-receipt"></i>
        </div>
        <div class="overview-info">
            <h6>Đơn tháng này</h6>
            <h3>@(stats?.MonthlyOrders ?? 0)</h3>
        </div>
    </div>
    <div class="overview-card">
        <div class="overview-icon teal">
            <i class="fas fa-users"></i>
        </div>
        <div class="overview-info">
            <h6>Tổng khách hàng</h6>
            <h3>@(stats?.TotalCustomers ?? 0)</h3>
        </div>
    </div>
    <div class="overview-card">
        <div class="overview-icon red">
            <i class="fas fa-utensils"></i>
        </div>
        <div class="overview-info">
            <h6>Tổng món ăn</h6>
            <h3>@(stats?.TotalDishes ?? 0)</h3>
        </div>
    </div>
</div>

<!-- Charts Row 1: Revenue -->
<div class="chart-container">
    <h5><i class="fas fa-chart-area"></i> Doanh thu 12 tháng gần nhất</h5>
    <div class="chart-wrapper">
        <canvas id="revenueChart"></canvas>
    </div>
</div>

<!-- Charts Row 2: Orders & Top Dishes -->
<div class="chart-row">
    <div class="chart-container">
        <h5><i class="fas fa-chart-bar"></i> Đơn hàng 7 ngày gần đây</h5>
        <div class="chart-wrapper">
            <canvas id="dailyOrdersChart"></canvas>
        </div>
    </div>
    <div class="chart-container">
        <h5><i class="fas fa-trophy"></i> Top 5 món bán chạy</h5>
        <div class="chart-wrapper">
            <canvas id="topDishesChart"></canvas>
        </div>
    </div>
</div>

<!-- Charts Row 3: Payment & Status -->
<div class="chart-row-three">
    <div class="chart-container">
        <h5><i class="fas fa-credit-card"></i> Phương thức thanh toán</h5>
        <div class="chart-wrapper-small">
            <canvas id="paymentChart"></canvas>
        </div>
    </div>
    <div class="chart-container">
        <h5><i class="fas fa-tasks"></i> Trạng thái đơn hàng</h5>
        <div class="chart-wrapper-small">
            <canvas id="statusChart"></canvas>
        </div>
    </div>
    <div class="chart-container">
        <h5><i class="fas fa-info-circle"></i> Thao tác nhanh</h5>
        <div class="d-flex flex-column gap-2 mt-3">
            <a href="/Admin/Employee/Create" class="btn btn-success">
                <i class="fas fa-user-plus me-2"></i>Thêm nhân viên mới
            </a>
            <a href="/Admin/Table/Create" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>Thêm bàn mới
            </a>
            <a href="/Admin/Dish/Create" class="btn btn-warning">
                <i class="fas fa-utensils me-2"></i>Thêm món ăn mới
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data from server
        const monthlyRevenueData = @Html.Raw(ViewBag.MonthlyRevenue);
        const dailyOrdersData = @Html.Raw(ViewBag.DailyOrders);
        const paymentMethodsData = @Html.Raw(ViewBag.PaymentMethods);
        const topDishesData = @Html.Raw(ViewBag.TopDishes);
        const orderStatusesData = @Html.Raw(ViewBag.OrderStatuses);

        // 1. Revenue Chart (Line)
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: monthlyRevenueData.map(x => x.Month),
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: monthlyRevenueData.map(x => x.Revenue),
                    borderColor: '#4a7c59',
                    backgroundColor: 'rgba(74, 124, 89, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#4a7c59',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
        options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('vi-VN').format(context.raw) + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN', { notation: 'compact' }).format(value);
                            }
                        }
                    }
                }
            }
        });

        // 2. Daily Orders Chart (Bar)
        new Chart(document.getElementById('dailyOrdersChart'), {
            type: 'bar',
            data: {
                labels: dailyOrdersData.map(x => x.Date),
                datasets: [{
                    label: 'Số đơn',
                    data: dailyOrdersData.map(x => x.Count),
                    backgroundColor: [
                        'rgba(52, 152, 219, 0.8)',
                        'rgba(46, 204, 113, 0.8)',
                        'rgba(155, 89, 182, 0.8)',
                        'rgba(241, 196, 15, 0.8)',
                        'rgba(230, 126, 34, 0.8)',
                        'rgba(231, 76, 60, 0.8)',
                        'rgba(26, 188, 156, 0.8)'
                    ],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 3. Payment Methods Chart (Doughnut)
        const paymentColors = {
            'COD': '#f39c12',
            'VNPay': '#3498db',
            'MoMo': '#d82d8b',
            'MoMoATM': '#a50064'
        };
        const paymentLabels = {
            'COD': 'Tiền mặt (COD)',
            'VNPay': 'VNPay',
            'MoMo': 'Ví MoMo',
            'MoMoATM': 'MoMo ATM'
        };
        new Chart(document.getElementById('paymentChart'), {
            type: 'doughnut',
            data: {
                labels: paymentMethodsData.map(x => paymentLabels[x.Method] || x.Method),
                datasets: [{
                    data: paymentMethodsData.map(x => x.Count),
                    backgroundColor: paymentMethodsData.map(x => paymentColors[x.Method] || '#95a5a6'),
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '60%'
            }
        });

        // 4. Top Dishes Chart (Horizontal Bar)
        new Chart(document.getElementById('topDishesChart'), {
            type: 'bar',
            data: {
                labels: topDishesData.map(x => x.DishName),
                datasets: [{
                    label: 'Số lượng bán',
                    data: topDishesData.map(x => x.Quantity),
                    backgroundColor: [
                        'rgba(231, 76, 60, 0.8)',
                        'rgba(230, 126, 34, 0.8)',
                        'rgba(241, 196, 15, 0.8)',
                        'rgba(46, 204, 113, 0.8)',
                        'rgba(52, 152, 219, 0.8)'
                    ],
                    borderRadius: 8
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 5. Order Status Chart (Pie)
        const statusColors = {
            'Chờ': '#f39c12',
            'Đang xử lý': '#3498db',
            'Hoàn thành': '#27ae60',
            'Hủy': '#e74c3c'
        };
        new Chart(document.getElementById('statusChart'), {
            type: 'pie',
            data: {
                labels: orderStatusesData.map(x => x.Status),
                datasets: [{
                    data: orderStatusesData.map(x => x.Count),
                    backgroundColor: orderStatusesData.map(x => statusColors[x.Status] || '#95a5a6'),
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
