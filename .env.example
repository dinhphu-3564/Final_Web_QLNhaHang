# ======================
# Database configuration
# ======================
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=QLNhaHangCK2
DB_TRUSTED_CONNECTION=True

# ======================
# VNPay configuration
# ======================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/Order/VnPayReturn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn

# ======================
# MoMo configuration
# ======================
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5000/Order/MoMoReturn
MOMO_IPN_URL=http://localhost:5000/Order/MoMoNotify

# ======================
# Email configuration
# ======================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_email_app_password
SENDER_NAME=Nha hang Viet
ADMIN_EMAIL=admin_email@gmail.com
